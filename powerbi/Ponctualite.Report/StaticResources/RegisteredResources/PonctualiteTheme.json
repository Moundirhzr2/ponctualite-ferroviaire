{
  "name": "PonctualiteTheme",
  "dataColors": [
    "#1B3A5C",
    "#E39A2B",
    "#3E7C8C",
    "#A63D40",
    "#6E7A87",
    "#8FB0C4",
    "#C9A227",
    "#4F6D7A",
    "#9AA5B1",
    "#2E7D5B"
  ],
  "background": "#FFFFFF",
  "foreground": "#1F2933",
  "tableAccent": "#1B3A5C",
  "good": "#2E7D5B",
  "neutral": "#E39A2B",
  "bad": "#A63D40",
  "maximum": "#1B3A5C",
  "center": "#8FB0C4",
  "minimum": "#EDF0F3",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#1F2933"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 10,
      "color": "#1F2933"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 9,
      "color": "#52606D"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 28,
      "color": "#1B3A5C"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E4E7EB"
              }
            },
            "radius": 6
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#1F2933"
              }
            },
            "fontSize": 12,
            "bold": true,
            "alignment": "left"
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "TopCenter",
            "showTitle": false,
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#52606D"
              }
            }
          }
        ],
        "categoryAxis": [
          {
            "showAxisTitle": false,
            "gridlineShow": false,
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#52606D"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "showAxisTitle": false,
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#52606D"
              }
            },
            "gridlineColor": {
              "solid": {
                "color": "#EDF0F3"
              }
            }
          }
        ],
        "labels": [
          {
            "fontSize": 9,
            "color": {
              "solid": {
                "color": "#52606D"
              }
            }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F4F6F8"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F4F6F8"
              }
            }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#1F2933"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 9
          }
        ]
      }
    }
  }
}